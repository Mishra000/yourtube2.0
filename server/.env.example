# ─── YourTube Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Frontend URL (for CORS — use your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# JWT Secret (for future JWT middleware if added)
JWT_SECRET=replace_with_a_long_random_secret_string

# Server port (Render sets this automatically)
PORT=5000

# Maximum participants allowed per meeting (default: 50)
MAX_MEETING_PARTICIPANTS=50

# ─── TURN Server (optional — for production WebRTC reliability) ─────────────
# These are NOT exposed to the browser. They are only used if you build
# a /api/turn-credentials endpoint to vend short-lived TURN tokens.
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
